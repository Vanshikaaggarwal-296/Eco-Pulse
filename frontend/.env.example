# Development: Vite forwards /api requests to the Python backend.
ECOPULSE_API_TARGET=http://127.0.0.1:8000
# Production: set the public backend origin (for example, your Render service URL).
# Never put API secrets in VITE_ variables; they are visible in the browser.
VITE_API_URL=
# Backward-compatible alias; VITE_API_URL takes precedence when both are set.
VITE_API_BASE_URL=
