{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "EcoPulse: Open running project",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "run_ecopulse.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "EcoPulse: Run integration tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "pytest",
        "tests/test_integration.py",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "EcoPulse: Rebuild GUI",
      "type": "process",
      "command": "C:/Users/harje/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node.exe",
      "args": [
        "node_modules/vite/bin/vite.js",
        "build",
        "--configLoader",
        "runner"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    }
  ]
}